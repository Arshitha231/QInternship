{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "empdirectory-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "empdirectory-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
