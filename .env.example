DATABASE_URL=sqlite:///directory.db

# AUTH_MODE=dev|entra. Leave unset: auto-detects "entra" once both Entra
# vars below are set, otherwise "dev" (reads role from X-Dev-Role header —
# local testing only, never enable in a deployed environment).
# AUTH_MODE=dev
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=

# --- Certification tracking ------------------------------------------------
# false (the default) runs course status off the seeded synthetic dataset.
# TrainingApiProvider isn't imported at all while this is off — flipping it
# to true is the only change needed to go live, once the open questions in
# app/certifications/training_api.py are settled with the other team.
# ENABLE_TRAINING_API_SYNC=false
# TRAINING_API_BASE_URL=
# TRAINING_API_KEY=
# TRAINING_API_TIMEOUT_SECONDS=5

# How far up the reporting chain a course-status resolution is reported.
# -1 (default) = unlimited, which is what's wanted today; 1 = direct manager
# only; 0 = employee notifications only. Does not affect who can *see*
# training status on a profile — that stays the full chain.
# NOTIFY_LEVELS_UP=-1

# Which org unit's people receive birthday and milestone work-anniversary
# notifications — everyone in it or beneath it. Resolved from the org tree
# because there is no role column and the sweep carries no role claim.
# Defaults to the HR Operations department; set to "People & Culture" to
# notify that whole division (which also includes Talent Acquisition).
# HR_ORG_UNIT_NAME=HR Operations
